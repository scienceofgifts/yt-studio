# GEMINI_API_KEY: Required for Gemini AI API calls on the separate API Worker.
# Users configure this as a secret on the Cloudflare API Worker via: wrangler secret put GEMINI_API_KEY
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GEMINI_API_URL: URL of your deployed separate Cloudflare API Worker (e.g. https://ambience-api.workers.dev)
# Leave blank for local development / same-origin Express server.
VITE_GEMINI_API_URL=""

# APP_URL: The URL where this applet frontend is hosted.
APP_URL="MY_APP_URL"

